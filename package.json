{
  "name": "immogest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx server.ts",
    "build": "npm run build:server && vite build",
    "build:functions": "tsc -p functions/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint firestore.rules",
    "test:verify": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/verifyProduction.ts",
    "start": "node --env-file-if-exists=.env.local dist-server/server.js",
    "preview": "vite preview",
    "test:business": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/paymentBoundaries.ts",
    "test:security": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/httpBoundaries.ts",
    "test:assembly-privacy": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/assemblyPrivacy.ts",
    "test:opening-balances": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/openingBalances.ts",
    "test:reserve-rate": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/reserveRateSync.ts",
    "test:quittance-integrity": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/quittanceIntegrity.ts",
    "test:subscription-capacity": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/subscriptionCapacity.ts",
    "test:monthly-billing": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/monthlyBillingIsolation.ts",
    "check:local": "npm run typecheck && npm run lint && npm run test:verify && npm run test:business && npm run test:cache && npm run test:security && npm run test:assembly-privacy && npm run test:opening-balances && npm run test:reserve-rate && npm run test:quittance-integrity && npm run test:subscription-capacity && npm run test:monthly-billing && npm run test:production && npm run test:recovery && npm run build:functions && npm run build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "test:production": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/productionReadiness.ts",
    "test:recovery": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/adminRecovery.ts",
    "test:auth:browser": "firebase emulators:exec --project demo-buildmanage --only auth \"node --import ./tests/helpers/networkGuard.mjs --import tsx tests/firebaseAuthBrowser.ts\"",
    "test:auth": "firebase emulators:exec --project demo-buildmanage --only auth \"node --import ./tests/helpers/networkGuard.mjs --import tsx tests/firebaseAuthentication.ts\"",
    "test:integration": "node --import tsx tests/firestoreIntegration.ts",
    "test:emulator": "firebase emulators:exec --project demo-buildmanage --only firestore \"npm run test:integration && npm run test:monthly-billing -- --firestore\"",
    "state:admin": "node --env-file-if-exists=.env.local --import tsx scripts/stateAdmin.ts",
    "test:ui": "playwright test",
    "test:cache": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/cacheBoundaries.ts",
    "test:ui:cloud": "node tests/helpers/runCloudUi.mjs",
    "diagnose": "node scripts/diagnoseDeployment.mjs"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@tanstack/react-query": "^5.28.4",
    "express": "^5.3.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.9"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1"
  }
}

