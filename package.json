{
  "name": "immogest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:functions": "tsc -p functions/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint firestore.rules",
    "test:verify": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/verifyProduction.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "test:business": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/paymentBoundaries.ts",
    "test:security": "node --import ./tests/helpers/networkGuard.mjs --import tsx tests/httpBoundaries.ts",
    "check:local": "npm run typecheck && npm run lint && npm run test:verify && npm run test:business && npm run test:security && npm run build:functions && npm run build"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@tanstack/react-query": "^5.28.4",
    "express": "^5.3.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
