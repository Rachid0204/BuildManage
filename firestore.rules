rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'wahbi.rachid@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidSyndic(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'subscriptionPlan', 'subscriptionStatus', 'createdBy', 'buildings']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'phone', 'logoUrl', 'ice', 'taxId', 'rc', 'patente', 'subscriptionPlan', 'subscriptionStatus', 'subscriptionExpiry', 'subscriptionExpiresAt', 'createdBy', 'buildings']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500)) &&
        (!('ice' in data) || (data.ice is string && data.ice.size() <= 32)) &&
        (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 32)) &&
        (!('rc' in data) || (data.rc is string && data.rc.size() <= 64)) &&
        (!('patente' in data) || (data.patente is string && data.patente.size() <= 64)) &&
        data.subscriptionPlan is string && data.subscriptionPlan.size() <= 32 && data.subscriptionPlan in ['starter', 'professional', 'enterprise'] &&
        data.subscriptionStatus is string && data.subscriptionStatus.size() <= 32 && data.subscriptionStatus in ['active', 'expired', 'cancelled'] &&
        (!('subscriptionExpiry' in data) || (data.subscriptionExpiry is string && data.subscriptionExpiry.size() <= 64)) &&
        (!('subscriptionExpiresAt' in data) || (data.subscriptionExpiresAt is string && data.subscriptionExpiresAt.size() <= 64)) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.buildings is list && data.buildings.size() <= 50 && (data.buildings.size() == 0 || data.buildings[0] is map);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'syndicId', 'buildingId', 'buildingName', 'apartmentId', 'apartmentNumber', 'isOwner', 'cin', 'phone', 'photoURL', 'mustChangePassword']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150 &&
        data.role is string && data.role.size() <= 32 && data.role in ['admin', 'syndic', 'resident', 'provider'] &&
        (!('syndicId' in data) || (data.syndicId is string && data.syndicId.size() <= 128)) &&
        (!('buildingId' in data) || (data.buildingId is string && data.buildingId.size() <= 128)) &&
        (!('buildingName' in data) || (data.buildingName is string && data.buildingName.size() <= 200)) &&
        (!('apartmentId' in data) || (data.apartmentId is string && data.apartmentId.size() <= 128)) &&
        (!('apartmentNumber' in data) || (data.apartmentNumber is string && data.apartmentNumber.size() <= 64)) &&
        (!('isOwner' in data) || data.isOwner is bool) &&
        (!('cin' in data) || (data.cin is string && data.cin.size() <= 32)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool);
    }

    function isValidPrestataire(data) {
      return data.keys().hasAll(['id', 'syndicId', 'buildingId', 'name', 'category']) &&
        data.keys().hasOnly(['id', 'syndicId', 'buildingId', 'name', 'category', 'contactPerson', 'phone', 'email', 'ice', 'rc', 'city', 'address', 'contractRef', 'monthlyRetainer', 'rating', 'status', 'interventionsCount', 'totalPaid', 'notes', 'hasAccount', 'generatedPassword', 'credentialsCreatedAt', 'credentialsSharedAt', 'credentialsLastSharedMethod', 'credentialsAuditLog', 'mustChangePassword']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.syndicId is string && data.syndicId.size() >= 1 && data.syndicId.size() <= 128 &&
        data.buildingId is string && data.buildingId.size() >= 1 && data.buildingId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        (!('contactPerson' in data) || (data.contactPerson is string && data.contactPerson.size() <= 150)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('hasAccount' in data) || data.hasAccount is bool) &&
        (!('generatedPassword' in data) || (data.generatedPassword is string && data.generatedPassword.size() <= 128)) &&
        (!('credentialsCreatedAt' in data) || (data.credentialsCreatedAt is string && data.credentialsCreatedAt.size() <= 64)) &&
        (!('credentialsSharedAt' in data) || (data.credentialsSharedAt is string && data.credentialsSharedAt.size() <= 64)) &&
        (!('credentialsLastSharedMethod' in data) || (data.credentialsLastSharedMethod is string && data.credentialsLastSharedMethod in ['pdf', 'copy'])) &&
        (!('credentialsAuditLog' in data) || (data.credentialsAuditLog is list && data.credentialsAuditLog.size() <= 50)) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool);
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    match /syndics/{syndicId} {
      allow get: if isSignedIn() && isValidId(syndicId) && (existing().createdBy == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().createdBy == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(syndicId) && isValidSyndic(incoming()) && incoming().id == syndicId && (incoming().createdBy == request.auth.uid || isAdmin());
      allow update: if isVerified() && isValidId(syndicId) && isValidSyndic(incoming()) && incoming().id == existing().id && incoming().createdBy == existing().createdBy && (
        isAdmin() ||
        (existing().createdBy == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'buildings', 'subscriptionPlan', 'subscriptionStatus', 'subscriptionExpiresAt']))
      );
      allow delete: if isVerified() && isValidId(syndicId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == userId && (
        (request.auth.uid == userId && incoming().role in ['syndic', 'resident', 'provider']) ||
        isAdmin()
      );
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'mustChangePassword', 'syndicId', 'buildingId', 'buildingName', 'apartmentId', 'apartmentNumber']))
      );
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    match /prestataires/{prestataireId} {
      allow get: if isSignedIn() && isValidId(prestataireId) && (
        isAdmin() ||
        get(/databases/$(database)/documents/syndics/$(existing().syndicId)).data.createdBy == request.auth.uid
      );
      allow list: if isSignedIn() && (existing().syndicId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(prestataireId) && isValidPrestataire(incoming()) && incoming().id == prestataireId && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/syndics/$(incoming().syndicId)) &&
         get(/databases/$(database)/documents/syndics/$(incoming().syndicId)).data.createdBy == request.auth.uid)
      );
      allow update: if isVerified() && isValidId(prestataireId) && isValidPrestataire(incoming()) && incoming().id == existing().id && incoming().syndicId == existing().syndicId && (
        isAdmin() ||
        (get(/databases/$(database)/documents/syndics/$(existing().syndicId)).data.createdBy == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'contactPerson', 'phone', 'email', 'buildingId', 'hasAccount', 'generatedPassword', 'credentialsCreatedAt', 'mustChangePassword']))
      );
      allow delete: if isVerified() && isValidId(prestataireId) && (
        isAdmin() ||
        get(/databases/$(database)/documents/syndics/$(existing().syndicId)).data.createdBy == request.auth.uid
      );
    }
  }
}