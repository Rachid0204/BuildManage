rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'wahbi.rachid@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidSyndic(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'subscriptionPlan', 'subscriptionStatus', 'createdBy', 'buildings']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'phone', 'city', 'address', 'logoUrl', 'ice', 'taxId', 'rc', 'patente', 'syndicType', 'bankName', 'rib', 'subscriptionPlan', 'subscriptionStatus', 'subscriptionExpiry', 'subscriptionExpiresAt', 'createdBy', 'updatedAt', 'buildings']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 2048)) &&
        (!('ice' in data) || (data.ice is string && data.ice.size() <= 32)) &&
        (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 32)) &&
        (!('rc' in data) || (data.rc is string && data.rc.size() <= 64)) &&
        (!('patente' in data) || (data.patente is string && data.patente.size() <= 64)) &&
        (!('syndicType' in data) || (data.syndicType is string && data.syndicType.size() <= 64)) &&
        (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 128)) &&
        (!('rib' in data) || (data.rib is string && data.rib.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        data.subscriptionPlan is string && data.subscriptionPlan.size() <= 32 && data.subscriptionPlan in ['starter', 'professional', 'enterprise'] &&
        data.subscriptionStatus is string && data.subscriptionStatus.size() <= 32 && data.subscriptionStatus in ['active', 'trialing', 'expired', 'cancelled'] &&
        (!('subscriptionExpiry' in data) || (data.subscriptionExpiry is string && data.subscriptionExpiry.size() <= 64)) &&
        (!('subscriptionExpiresAt' in data) || (data.subscriptionExpiresAt is string && data.subscriptionExpiresAt.size() <= 64)) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.buildings is list && data.buildings.size() <= 50 && (data.buildings.size() == 0 || data.buildings[0] is map);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'syndicId', 'buildingId', 'buildingName', 'apartmentId', 'apartmentNumber', 'residentId', 'prestataireId', 'prestataireCategory', 'subscriptionPlan', 'subscriptionStatus', 'createdAt', 'isOwner', 'cin', 'phone', 'photoURL', 'mustChangePassword']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150 &&
        data.role is string && data.role.size() <= 32 && data.role in ['admin', 'syndic', 'resident', 'provider'] &&
        (!('syndicId' in data) || (data.syndicId is string && data.syndicId.size() <= 128)) &&
        (!('buildingId' in data) || (data.buildingId is string && data.buildingId.size() <= 128)) &&
        (!('buildingName' in data) || (data.buildingName is string && data.buildingName.size() <= 200)) &&
        (!('apartmentId' in data) || (data.apartmentId is string && data.apartmentId.size() <= 128)) &&
        (!('apartmentNumber' in data) || (data.apartmentNumber is string && data.apartmentNumber.size() <= 64)) &&
        (!('residentId' in data) || (data.residentId is string && data.residentId.size() <= 128)) &&
        (!('prestataireId' in data) || (data.prestataireId is string && data.prestataireId.size() <= 128)) &&
        (!('prestataireCategory' in data) || (data.prestataireCategory is string && data.prestataireCategory.size() <= 64)) &&
        (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 32 && data.subscriptionPlan in ['starter', 'professional', 'enterprise'])) &&
        (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus.size() <= 32 && data.subscriptionStatus in ['active', 'trialing', 'expired', 'cancelled'])) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('isOwner' in data) || data.isOwner is bool) &&
        (!('cin' in data) || (data.cin is string && data.cin.size() <= 32)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool);
    }

    function isValidPrestataire(data) {
      return data.keys().hasAll(['id', 'syndicId', 'buildingId', 'name', 'category']) &&
        data.keys().hasOnly(['id', 'syndicId', 'buildingId', 'name', 'category', 'contactPerson', 'phone', 'whatsapp', 'email', 'ice', 'rc', 'city', 'address', 'contractRef', 'monthlyRetainer', 'hourlyRate', 'rating', 'status', 'active', 'isEmergency247', 'isVerifiedBySyndic', 'verified', 'reviewsCount', 'reviews', 'completedJobsCount', 'interventionsCount', 'totalPaid', 'description', 'specialties', 'contractType', 'availability', 'responseTimeHours', 'notes', 'hasAccount', 'invitationCode', 'invitationToken', 'invitationStatus', 'invitationExpiresAt', 'credentialsCreatedAt', 'credentialsSharedAt', 'credentialsLastSharedMethod', 'credentialsAuditLog', 'mustChangePassword']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.syndicId is string && data.syndicId.size() >= 1 && data.syndicId.size() <= 128 &&
        data.buildingId is string && data.buildingId.size() >= 1 && data.buildingId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        (!('contactPerson' in data) || (data.contactPerson is string && data.contactPerson.size() <= 150)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('hasAccount' in data) || data.hasAccount is bool) &&
        (!('invitationCode' in data) || (data.invitationCode is string && data.invitationCode.size() <= 128)) &&
        (!('invitationToken' in data) || (data.invitationToken is string && data.invitationToken.size() <= 128)) &&
        (!('invitationStatus' in data) || (data.invitationStatus is string && data.invitationStatus in ['pending', 'accepted', 'sent', 'active', 'expired'])) &&
        (!('invitationExpiresAt' in data) || (data.invitationExpiresAt is string && data.invitationExpiresAt.size() <= 64)) &&
        (!('credentialsCreatedAt' in data) || (data.credentialsCreatedAt is string && data.credentialsCreatedAt.size() <= 64)) &&
        (!('credentialsSharedAt' in data) || (data.credentialsSharedAt is string && data.credentialsSharedAt.size() <= 64)) &&
        (!('credentialsLastSharedMethod' in data) || (data.credentialsLastSharedMethod is string && data.credentialsLastSharedMethod in ['pdf', 'copy'])) &&
        (!('credentialsAuditLog' in data) || (data.credentialsAuditLog is list && data.credentialsAuditLog.size() <= 50)) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool);
    }

    function isValidAccountCredential(data) {
      return !('password' in data) &&
        !('generatedPassword' in data) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.passwordHash is string && (data.passwordHash.matches('^pbkdf2\\$.*') || data.passwordHash.size() >= 16) && data.passwordHash.size() <= 256 &&
        data.syndicId is string && data.syndicId.size() >= 1 && data.syndicId.size() <= 128 &&
        data.buildingId is string && data.buildingId.size() >= 1 && data.buildingId.size() <= 128;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'message', 'type', 'read', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.type is string && data.type in ['invoice', 'maintenance', 'announcement', 'general'] &&
        data.read is bool &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    match /syndics/{syndicId} {
      allow get, list: if true;
      allow create, update: if isValidId(syndicId) && isValidSyndic(incoming()) && incoming().id == syndicId;
      allow delete: if isVerified() && isValidId(syndicId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == userId && (
        (request.auth.uid == userId && incoming().role in ['syndic', 'resident', 'provider']) ||
        isAdmin()
      );
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'mustChangePassword']))
      );
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    match /prestataires/{prestataireId} {
      allow get, list: if true;
      allow create, update: if isValidId(prestataireId) && isValidPrestataire(incoming()) && incoming().id == prestataireId;
      allow delete: if isSignedIn() && isValidId(prestataireId);
    }

    match /resident_accounts/{residentId} {
      allow get, list: if true;
      allow create, update: if isValidId(residentId) && isValidAccountCredential(incoming());
      allow delete: if isSignedIn() && isValidId(residentId);
    }

    match /prestataire_accounts/{prestataireId} {
      allow get, list: if true;
      allow create, update: if isValidId(prestataireId) && isValidAccountCredential(incoming());
      allow delete: if isSignedIn() && isValidId(prestataireId);
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(notificationId) && isValidNotification(incoming()) && isAdmin();
      allow update: if isVerified() && isValidId(notificationId) && isValidNotification(incoming()) && existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isVerified() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}