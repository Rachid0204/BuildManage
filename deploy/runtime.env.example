# Nonsecret production manifest. Bind secrets privately; never commit values.
NODE_ENV=production
SYNDIK_STATE_BACKEND=firestore
SYNDIK_UPLOAD_BACKEND=gcs
SYNDIK_AUTH_PROVIDER=firebase
GOOGLE_CLOUD_PROJECT=immogest-7faaf
FIRESTORE_DATABASE_ID=ai-studio-immogest-6d16b790-183d-49fd-9d4f-086d99dc2be3
PUBLIC_APP_URL=https://immogest.cloud.run
SYNDIK_UPLOAD_BUCKET=immogest-7faaf-uploads
CLOUD_RUN_SERVICE=buildmanage
CLOUD_RUN_REGION=europe-west1
TRUST_PROXY_HOPS=1
# Keep this legacy key stable while retained v1 envelopes are being migrated.
SYNDIK_SERVER_SECRET=
# Dedicated signing key; can rotate independently from durable encryption keys.
SYNDIK_SESSION_SECRET=
# JSON keyring: {"primary":{"kid":"enc-v2","key":"<32+ random chars>"},"retired":[]}
SYNDIK_ENCRYPTION_KEYS=
SYNDIK_SCHEDULER_SECRET=
# Scheduled Functions must use the same scheduler secret and this backend URL.
SYNDIK_BACKEND_URL=https://immogest.cloud.run
