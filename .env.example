# Local development builds/tests work without these secrets. Never commit .env.local.
# Public frontend Firebase values fall back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# Production: see docs/deployment-contract.md and deploy/runtime.env.example.
# Preserve the existing stable server key; never rotate it as part of deployment.
# Backend: file in development, Firestore required in production.
# SYNDIK_STATE_BACKEND=firestore
# SYNDIK_UPLOAD_BACKEND=gcs
FIRESTORE_DATABASE_ID=
GOOGLE_CLOUD_PROJECT=
SYNDIK_SERVER_SECRET=
# Optional dedicated session HMAC signing key (>=32 random chars); falls back to SYNDIK_SERVER_SECRET.
SYNDIK_SESSION_SECRET=
# Production durable encryption keyring JSON: {"primary":{"kid":"enc-v2","key":"<32+ random chars>"},"retired":[]}
SYNDIK_ENCRYPTION_KEYS=
SYNDIK_DATA_DIR=
PUBLIC_APP_URL=
SYNDIK_UPLOAD_BUCKET=
TRUST_PROXY_HOPS=0
# Browser Content-Security-Policy mode: report-only (default) or enforce.
CSP_MODE=report-only

# Firebase handles account emails without SendGrid. Enable Email/Password in Firebase Console.
SYNDIK_AUTH_PROVIDER=firebase
# Optional backend override; defaults to firebase-applet-config.json apiKey.
FIREBASE_API_KEY=
# Optional explicit Firebase project alias; production GOOGLE_CLOUD_PROJECT must be set.
FIREBASE_PROJECT_ID=

# Optional legacy/general-purpose transactional email provider.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Both backend and scheduled Functions use this separate shared secret.
SYNDIK_SCHEDULER_SECRET=
# Functions only:
SYNDIK_BACKEND_URL=

# Optional exact verified Google account for admin bootstrap; no automatic password promotion.
SYNDIK_BOOTSTRAP_ADMIN_EMAIL=
# Operator backup/restore only; use a separate key, retained outside the backup.
SYNDIK_BACKUP_KEY=
CMI_ENABLED=false

# Optional Platform Subscription Billing Defaults (overridable in Admin -> Configuration Paiements)
# PayPal Standard & Expanded Checkout (buttons + card-fields)
PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CHECKOUT_MODE=expanded
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=EUR
PAYPAL_MAD_PER_UNIT=10
# Optional fixed monthly PayPal price overrides per plan (in PAYPAL_CURRENCY):
PAYPAL_PRICE_STARTER=
PAYPAL_PRICE_PRO=
PAYPAL_PRICE_ENTERPRISE=

# Moroccan Bank Transfer (Virement Bancaire Maroc)
SUBSCRIPTION_BANK_ENABLED=false
SUBSCRIPTION_BANK_NAME=
SUBSCRIPTION_BANK_HOLDER=
SUBSCRIPTION_BANK_RIB=
SUBSCRIPTION_BANK_IBAN=
SUBSCRIPTION_BANK_SWIFT=
SUBSCRIPTION_BANK_ICE=
SUBSCRIPTION_BANK_INSTRUCTIONS_FR=
SUBSCRIPTION_BANK_INSTRUCTIONS_AR=
