# ============================================================================
# ImmoGest / Syndik Maroc — Environment Configuration Template
# Copy this file to .env.local for local development (never commit real secrets)
# ============================================================================

# --- Client Firebase Configuration (Optional overrides for firebase-applet-config.json) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=ai-studio-979bb767-de87-42fa-901d-76ba2f20572a

# When set to "true", uses local/shared-state persistence instead of live Firestore calls
VITE_USE_MOCK_DATA=false

# --- Server-Side Only Secrets (Used by server.ts and Cloud Functions) ---
GEMINI_API_KEY=
FIRESTORE_DATABASE_ID=ai-studio-979bb767-de87-42fa-901d-76ba2f20572a

# CMI Payment Gateway (Keep CMI_ENABLED=false until official merchant verification is complete)
CMI_ENABLED=false
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate

# Transactional Email Provider (Cloud Functions)
SENDGRID_API_KEY=
