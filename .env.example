# Local development builds/tests work without these secrets. Never commit .env.local.
# Public frontend Firebase values fall back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# Backend: file in development, Firestore in production (file is refused).
# SYNDIK_STATE_BACKEND=firestore
FIRESTORE_DATABASE_ID=
GOOGLE_CLOUD_PROJECT=
SYNDIK_SERVER_SECRET=
SYNDIK_DATA_DIR=
PUBLIC_APP_URL=
SYNDIK_UPLOAD_BUCKET=
TRUST_PROXY_HOPS=0

# Production registration/recovery require real email configuration.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Both backend and scheduled Functions use this separate shared secret.
SYNDIK_SCHEDULER_SECRET=
# Functions only:
SYNDIK_BACKEND_URL=

# Optional exact verified Google account for admin bootstrap; no automatic password promotion.
SYNDIK_BOOTSTRAP_ADMIN_EMAIL=
# Operator backup/restore only; use a separate key, retained outside the backup.
SYNDIK_BACKUP_KEY=
# Optional AI; proof approval always requires authorized human review.
GEMINI_API_KEY=
CMI_ENABLED=false
